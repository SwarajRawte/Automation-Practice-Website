# Local development defaults. Replace the local credentials before sharing.
HOST=127.0.0.1
PORT=3100
JWT_SECRET=local-development-secret-change-me
TEST_MODE=true
DB_PATH=./data/testlab.db
APP_ORIGIN=http://localhost:5173
# Optional genuine second-origin iframe fixture used by the advanced lab.
SECOND_ORIGIN_HOST=127.0.0.1
SECOND_ORIGIN_PORT=3200
SECOND_ORIGIN_URL=http://localhost:3200
# VITE_ values are public browser configuration and must never contain secrets.
VITE_SECOND_ORIGIN_URL=http://localhost:3200
# Additional trusted iframe origins may be comma-separated for the app CSP.
# FRAME_ORIGINS=https://fixtures.example.test
# Graceful shutdown deadline, constrained by the server to 1-30 seconds.
# SHUTDOWN_TIMEOUT_MS=10000
# Optional Docker browser origin; Compose defaults to http://localhost:3000.
# DOCKER_APP_ORIGIN=http://localhost:3000
# DOCKER_SECOND_ORIGIN_URL=http://localhost:3200
# Docker stays fail-closed unless both values are explicitly supplied.
# DOCKER_TEST_MODE=false
# DOCKER_TEST_CONTROL_KEY=replace-with-a-docker-test-control-key
COOKIE_SECURE=false
MAX_LOGIN_ATTEMPTS=5
TEST_CONTROL_KEY=testlab-control
# Optional lifecycle-only key; falls back to TEST_CONTROL_KEY when omitted.
# TEST_RUN_KEY=replace-with-a-dedicated-run-lifecycle-key
# Bounded isolated-worker defaults: 16 runs, 60-minute idle TTL, 16 MiB snapshots/run.
# TEST_RUN_MAX=16
# TEST_RUN_TTL_MS=3600000
# TEST_RUN_SNAPSHOT_MAX_BYTES=16777216
# Optional override; when omitted, Vite proxies to the host and PORT above.
# VITE_API_TARGET=http://localhost:3100
