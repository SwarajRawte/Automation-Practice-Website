{
  "name": "e2e-test-lab",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently \"node --env-file-if-exists=.env --import=tsx --watch server/index.ts\" \"vite\"",
    "dev:origin": "node --env-file-if-exists=.env --import=tsx --watch server/secondOrigin.ts",
    "dev:all": "concurrently \"node --env-file-if-exists=.env --import=tsx --watch server/index.ts\" \"vite\" \"node --env-file-if-exists=.env --import=tsx --watch server/secondOrigin.ts\"",
    "build": "tsc -b && vite build",
    "start": "node --env-file-if-exists=.env --import=tsx server/index.ts",
    "test": "node --import=tsx --import=./server/testSetup.ts --test --test-concurrency=1 server/**/*.test.ts",
    "seed": "node --env-file-if-exists=.env --import=tsx server/scripts/seed.ts",
    "reset": "node --env-file-if-exists=.env --import=tsx server/scripts/reset.ts",
    "lint": "eslint .",
    "typecheck": "tsc -b"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "express": "^5.2.1",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "lucide-react": "^1.34.0",
    "multer": "^2.2.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.2",
    "socket.io": "^4.8.3",
    "socket.io-client": "^4.8.3",
    "swagger-ui-express": "^5.0.1",
    "tsx": "^4.23.12"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "^2.2.0",
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@types/supertest": "^7.2.1",
    "@types/swagger-ui-express": "^4.1.8",
    "@vitejs/plugin-react": "^6.1.0",
    "concurrently": "^10.0.5",
    "eslint": "^10.9.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.11.0",
    "prettier": "^3.9.6",
    "supertest": "^7.2.2",
    "typescript": "^7.0.2",
    "typescript-eslint": "^8.68.0",
    "vite": "^8.2.2"
  },
  "engines": {
    "node": ">=22.12"
  }
}
